diff --git a/drivers/usb/mtu3/mtu3.h b/drivers/usb/mtu3/mtu3.h
index c11840b9a..2b8d6b535 100644
--- a/drivers/usb/mtu3/mtu3.h
+++ b/drivers/usb/mtu3/mtu3.h
@@ -361,6 +361,7 @@ struct mtu3 {
 	unsigned connected:1;
 	unsigned async_callbacks:1;
 	unsigned separate_fifo:1;
+	unsigned force_vbus:1;
 
 	u8 address;
 	u8 test_mode_nr;
diff --git a/drivers/usb/mtu3/mtu3_core.c b/drivers/usb/mtu3/mtu3_core.c
index a3a628289..d600d73fd 100644
--- a/drivers/usb/mtu3/mtu3_core.c
+++ b/drivers/usb/mtu3/mtu3_core.c
@@ -11,6 +11,7 @@
 #include <linux/dma-mapping.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
 #include <linux/platform_device.h>
@@ -350,6 +351,21 @@ void mtu3_dev_on_off(struct mtu3 *mtu, int is_on)
 		usb_speed_string(mtu->speed), is_on ? "+" : "-");
 }
 
+/* Some MT6779 boards report peripheral VBUS to the MAC in software. */
+static void mtu3_set_peripheral_vbus(struct mtu3 *mtu, bool connected)
+{
+	if (!mtu->force_vbus)
+		return;
+
+	if (connected) {
+		mtu3_clrbits(mtu->ippc_base, SSUSB_U2_CTRL(0), SSUSB_U2_PORT_OTG_SEL);
+		mtu3_setbits(mtu->mac_base, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
+	} else {
+		mtu3_setbits(mtu->ippc_base, SSUSB_U2_CTRL(0), SSUSB_U2_PORT_OTG_SEL);
+		mtu3_clrbits(mtu->mac_base, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
+	}
+}
+
 void mtu3_start(struct mtu3 *mtu)
 {
 	void __iomem *mbase = mtu->mac_base;
@@ -360,6 +376,7 @@ void mtu3_start(struct mtu3 *mtu)
 	mtu3_dev_power_on(mtu);
 	mtu3_csr_init(mtu);
 	mtu3_set_speed(mtu, mtu->speed);
+	mtu3_set_peripheral_vbus(mtu, true);
 
 	/* Initialize the default interrupts */
 	mtu3_intr_enable(mtu);
@@ -378,6 +395,7 @@ void mtu3_stop(struct mtu3 *mtu)
 	if (mtu->softconnect)
 		mtu3_dev_on_off(mtu, 0);
 
+	mtu3_set_peripheral_vbus(mtu, false);
 	mtu->is_active = 0;
 	mtu3_dev_power_down(mtu);
 }
@@ -955,6 +973,11 @@ int ssusb_gadget_init(struct ssusb_mtk *ssusb)
 	ssusb->u3d = mtu;
 	mtu->ssusb = ssusb;
 	mtu->max_speed = usb_get_maximum_speed(dev);
+	mtu->force_vbus = ssusb->dr_mode == USB_DR_MODE_PERIPHERAL &&
+		of_machine_is_compatible("mediatek,MT6779") &&
+		of_property_read_bool(dev->of_node, "mediatek,force-vbus");
+	if (mtu->force_vbus)
+		dev_info(dev, "using MT6779 software peripheral VBUS detection\n");
 
 	dev_dbg(dev, "mac_base=0x%p, ippc_base=0x%p\n",
 		mtu->mac_base, mtu->ippc_base);
